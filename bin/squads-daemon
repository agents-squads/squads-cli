#!/bin/bash
#
# squads-daemon - Background daemon for Agents Squads
#
# Manages all background automation:
# - Agent scheduler (triggers, routines)
# - GitHub follow worker
# - Twitter follow worker
#
# Usage:
#   squads-daemon start      Start workers in background
#   squads-daemon stop       Stop all workers
#   squads-daemon status     Show worker status
#   squads-daemon daemon     Run in foreground (for launchd)
#

set -e

AGENTS_SQUADS_HOME="${AGENTS_SQUADS_HOME:-$HOME/agents-squads}"
HQ_DIR="$AGENTS_SQUADS_HOME/hq"
SCRIPTS_DIR="$HQ_DIR/scripts"
API_DIR="$AGENTS_SQUADS_HOME/squads-api"
LOG_DIR="$HQ_DIR/logs"
PID_DIR="$HQ_DIR/.pids"

# Ensure directories exist
mkdir -p "$LOG_DIR" "$PID_DIR"

# Colors (for terminal output)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_DIR/scheduler.log"
    echo -e "$1"
}

# Worker definitions: name|path|type (loop=interval-based, daemon=long-running)
# Format: name|script_path|type|interval_or_na
WORKERS=(
    "procrastinate|$API_DIR/run-scheduler.sh|daemon|0"
    "github-follow|$SCRIPTS_DIR/github-follow-worker.sh|loop|1800"
    "twitter-follow|$SCRIPTS_DIR/twitter-follow-worker.sh|loop|3600"
)

start_worker() {
    local name="$1"
    local script="$2"
    local type="$3"
    local interval="$4"
    local pid_file="$PID_DIR/${name}.pid"
    local log_file="$LOG_DIR/${name}.log"

    # Check if already running
    if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
        log "${YELLOW}[SKIP]${NC} $name already running (PID: $(cat "$pid_file"))"
        return 0
    fi

    # Check if script exists
    if [ ! -f "$script" ]; then
        log "${YELLOW}[SKIP]${NC} $name script not found: $script"
        return 0
    fi

    if [ "$type" = "daemon" ]; then
        # Long-running daemon (like Procrastinate)
        "$script" >> "$log_file" 2>&1 &
        local pid=$!
        echo "$pid" > "$pid_file"
        log "${GREEN}[START]${NC} $name (PID: $pid, daemon)"
    else
        # Interval-based loop worker
        (
            while true; do
                "$script" >> "$log_file" 2>&1 || true
                sleep "$interval"
            done
        ) &
        local pid=$!
        echo "$pid" > "$pid_file"
        log "${GREEN}[START]${NC} $name (PID: $pid, interval: ${interval}s)"
    fi
}

stop_worker() {
    local name="$1"
    local pid_file="$PID_DIR/${name}.pid"

    if [ -f "$pid_file" ]; then
        local pid=$(cat "$pid_file")
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
            # Also kill children
            pkill -P "$pid" 2>/dev/null || true
            log "${RED}[STOP]${NC} $name (PID: $pid)"
        fi
        rm -f "$pid_file"
    fi
}

status_worker() {
    local name="$1"
    local pid_file="$PID_DIR/${name}.pid"

    if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
        echo -e "${GREEN}●${NC} $name (PID: $(cat "$pid_file"))"
    else
        echo -e "${RED}○${NC} $name (stopped)"
    fi
}

start_all() {
    log "Starting Squads Scheduler..."
    for worker in "${WORKERS[@]}"; do
        IFS='|' read -r name script type interval <<< "$worker"
        start_worker "$name" "$script" "$type" "$interval"
    done
    log "Squads Scheduler started"
}

stop_all() {
    log "Stopping Squads Scheduler..."
    for worker in "${WORKERS[@]}"; do
        IFS='|' read -r name script type interval <<< "$worker"
        stop_worker "$name"
    done
    log "Squads Scheduler stopped"
}

status_all() {
    echo "Squads Scheduler Status"
    echo "━━━━━━━━━━━━━━━━━━━━━━━"
    for worker in "${WORKERS[@]}"; do
        IFS='|' read -r name script type interval <<< "$worker"
        status_worker "$name"
    done
    echo ""
    echo "Logs: $LOG_DIR"
}

# Handle signals for clean shutdown
trap stop_all SIGTERM SIGINT

# Main
case "${1:-}" in
    start)
        start_all
        ;;
    stop)
        stop_all
        ;;
    restart)
        stop_all
        sleep 1
        start_all
        ;;
    status)
        status_all
        ;;
    daemon)
        # Foreground mode for launchd - starts workers and stays alive
        start_all
        log "Running in daemon mode (foreground)..."
        while true; do
            sleep 3600
        done
        ;;
    *)
        echo "Usage: squads-daemon {start|stop|restart|status|daemon}"
        echo ""
        echo "Commands:"
        echo "  start   Start workers in background"
        echo "  stop    Stop all workers"
        echo "  restart Restart all workers"
        echo "  status  Show worker status"
        echo "  daemon  Run in foreground (for launchd)"
        exit 1
        ;;
esac
