# Squads API - Caddy Reverse Proxy
#
# Automatic HTTPS via Let's Encrypt
# Routes traffic to internal services
#
# Environment:
#   DOMAIN - Primary domain (default: api.agents-squads.com)

{$DOMAIN:api.agents-squads.com} {
    # Scheduler API - main API endpoints
    handle /api/* {
        reverse_proxy scheduler-api:8090
    }

    # Health check
    handle /health {
        reverse_proxy scheduler-api:8090
    }

    # Approvals endpoints
    handle /approvals/* {
        reverse_proxy scheduler-api:8090
    }

    # Escalations endpoints
    handle /escalations/* {
        reverse_proxy scheduler-api:8090
    }

    # Slack endpoints (OAuth, events, interactions)
    handle /slack/* {
        reverse_proxy scheduler-api:8090
    }

    # Auth endpoints (OAuth flows)
    handle /auth/* {
        reverse_proxy scheduler-api:8090
    }

    # Webhooks (Stripe, GitHub, etc.)
    handle /webhooks/* {
        reverse_proxy scheduler-api:8090
    }

    # Triggers and executions
    handle /triggers/* {
        reverse_proxy scheduler-api:8090
    }

    handle /executions/* {
        reverse_proxy scheduler-api:8090
    }

    # Memory and learnings
    handle /memory/* {
        reverse_proxy scheduler-api:8090
    }

    handle /learnings/* {
        reverse_proxy scheduler-api:8090
    }

    # Slack bot HTTP API (for CLI integration)
    handle /bot/* {
        uri strip_prefix /bot
        reverse_proxy slack-bot:3001
    }

    # Default - scheduler API
    handle {
        reverse_proxy scheduler-api:8090
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Logging
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 5
        }
        format json
    }
}

# Health check endpoint for load balancers
:8080 {
    respond /health "OK" 200
}
